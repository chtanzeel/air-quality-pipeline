# Copy to .env (gitignored):  cp .env.example .env
# These defaults are for a local, single-machine setup only. Change the passwords for anything else.

# --- Postgres server (one container hosting both databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_only

# --- Warehouse database (pipeline data: raw, ops, dbt schemas) ---
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse_local_only
# Host and port as seen from your machine. Containers override these to postgres:5432.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432

# --- Airflow metadata database (kept separate from the warehouse) ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_local_only

# --- Pipeline ---
# First hour with CAMS global data on Open-Meteo (see docs/probe_findings.md).
AQ_START_DATE=2022-08-04
# Re-fetch this many hours before the watermark on every run, to pick up upstream revisions.
AQ_LOOKBACK_HOURS=48
# Backfills are split into request windows of at most this many days.
AQ_WINDOW_DAYS=31
# Pause between API requests.
AQ_REQUEST_SLEEP_SECONDS=1

# --- Airflow ---
# UI login at http://localhost:8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Signs tokens between Airflow components. Any long random string.
AIRFLOW_JWT_SECRET=local-only-change-me-to-a-long-random-string
# Linux only: your user id (`id -u`) so files Airflow writes are owned by you. Ignored on Windows/macOS.
AIRFLOW_UID=50000
