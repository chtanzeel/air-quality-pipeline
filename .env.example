# Copy to .env (gitignored):  cp .env.example .env
# These defaults are for a local, single-machine setup only. Change the passwords for anything else.

# --- Postgres server (one container hosting both databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_only

# --- Warehouse database (pipeline data: raw, ops, dbt schemas) ---
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse_local_only
# Host and port as seen from your machine. Containers override these to postgres:5432.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432

# --- Airflow metadata database (kept separate from the warehouse) ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_local_only
